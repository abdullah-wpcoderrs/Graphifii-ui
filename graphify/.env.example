# ---------------------------------------------------------------------------
# SERVICE_ROLE — which process the unified platform image starts
# ---------------------------------------------------------------------------
# One image (Dockerfile.platform) serves four roles. This variable is the only
# thing that distinguishes them:
#
#   api        the public backend             -> graphify-server
#   worker     private queue dispatcher       -> graphify-run-worker
#   extractor  one sandboxed extraction       -> sandbox_entrypoint.py
#   migrate    one-shot `alembic upgrade head`
#
# There is no default. An unset or misspelled role makes the container exit
# non-zero instead of guessing — a worker that silently became an API would be
# holding database credentials and a public domain.
#
# You do NOT normally set this here. Compose sets it per service, Railway sets
# it per service, and the worker injects SERVICE_ROLE=extractor into each
# extraction deployment itself. It is listed for reference.
# SERVICE_ROLE=api

# Application origins
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Backend persistence and cryptography
# Use the "postgresql+psycopg://" prefix so SQLAlchemy's async engine selects
# the psycopg3 driver. Neon: copy the pooled connection string from the
# console and swap the scheme prefix.
#
# Neon publishes TWO connection strings and they are not interchangeable:
#
#   POOLED (host contains "-pooler")  -> DATABASE_URL, below.
#     Correct for the long-running API and worker: many short queries sharing
#     a small number of real Postgres connections via PgBouncer.
#
#   DIRECT (no "-pooler")             -> DATABASE_URL_DIRECT, below.
#     Required for Alembic. Migrations use DDL and advisory locks, which do
#     not behave correctly through a transaction pooler.
#
# Use a Neon DEVELOPMENT BRANCH here — never the production branch. A branch
# is a copy-on-write fork of production's schema, free to create and reset.
DATABASE_URL=postgresql+psycopg://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Only the migration process retains this. The platform dispatcher removes it
# before exec'ing API/worker and promotes it to DATABASE_URL only for Alembic.
DATABASE_URL_DIRECT=postgresql+psycopg://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Generate separately with: openssl rand -base64 32
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Generate separately with: openssl rand -base64 32 (must differ from SESSION_SECRET)
TOKEN_ENCRYPTION_KEY=replace-with-a-separate-32-byte-base64-key

# GitHub App credentials (see docs/github-app-setup.md)
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Admin area (Phase 4) — email/password login, isolated from GitHub auth.
# ---------------------------------------------------------------------------
# Signs the admin session cookie. Generate with: openssl rand -base64 48
# MUST differ from SESSION_SECRET and TOKEN_ENCRYPTION_KEY — the server
# refuses to start otherwise, since reusing one collapses the isolation.
# Until this is set, /api/admin/login returns 503.
ADMIN_SESSION_SECRET=

# Used ONLY by scripts/seed_admin.py to create/reset the admin account:
#   uv run python scripts/seed_admin.py
# The plaintext is hashed with argon2 and never stored. Minimum 12 chars.
# Clear these after seeding — the running server does not read them.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Railway sandbox provisioning (Phase 4) — see docs/railway-setup.md
# ---------------------------------------------------------------------------
# All four must be set before "Launch Workspace" works; until then the launch
# route returns 503 with a clear not-configured message.
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=

# Public base URL the SANDBOX CONTAINER uses to reach this backend.
#
# Leave unset in production — it falls back to BACKEND_URL, which is already
# your public origin there.
#
# In local development you MUST set this to a tunnel URL (cloudflared/ngrok),
# and you must NOT just change BACKEND_URL instead: BACKEND_URL also builds
# the GitHub/GitLab OAuth redirect URIs (registered with those providers) and
# decides the Secure cookie flag — an https:// value there stops your browser
# sending session cookies over http://localhost. A Railway container, meanwhile,
# cannot reach localhost at all. The two URLs are genuinely different in dev.
#
# Quick tunnel (new random URL on every restart — update this each time):
#   cloudflared tunnel --url http://localhost:8000
SANDBOX_CALLBACK_BASE_URL=

# Redis Streams delivers queued run IDs immediately. PostgreSQL remains the
# source of truth and is polled as a recovery path if Redis is unavailable.
# On Railway, set this with a reference to the Redis service's private URL.
REDIS_URL=
REDIS_RUN_QUEUE_STREAM=graphify:extraction-runs
REDIS_RUN_QUEUE_GROUP=graphify-dispatchers
REDIS_RUN_QUEUE_BLOCK_MS=2000
REDIS_RUN_QUEUE_RECLAIM_SECONDS=60
REDIS_RUN_QUEUE_MAX_LENGTH=10000

# RUN_WORKER_ENABLED controls the worker embedded in graphify-server. Keep it
# true for simple local development. In production set it false on every API
# replica and run a separate service with start command `graphify-run-worker`.
# PostgreSQL serialization still ensures only one shared Railway sandbox
# deployment is active, even if more than one worker process starts.
RUN_WORKER_ENABLED=true
RUN_WORKER_POLL_SECONDS=2
RUN_WORKER_LEASE_SECONDS=14400
MAX_QUEUED_RUNS_PER_USER=3
MAX_QUEUED_RUNS_GLOBAL=100

# Where extraction outputs (graph.json / files.json) are written.
WORKSPACE_STORAGE_TYPE=local
# Only meaningful when WORKSPACE_STORAGE_TYPE=local. In the platform image
# this is the Railway volume mount point, and the entrypoint chowns it to the
# unprivileged runtime user before dropping root. Locally, Compose mounts the
# `workspace-artifacts` named volume here.
WORKSPACE_STORAGE_DIR=/data/workspaces

# ---------------------------------------------------------------------------
# Local Docker Compose (see compose.yaml at the repository root)
# ---------------------------------------------------------------------------
#   docker compose up --build                     start API + worker + Redis
#   docker compose --profile migrate run --rm migrate     migrate your branch
#   docker compose down                           stop, KEEP volumes
#   docker compose down --volumes                 stop, ERASE local volumes
#
# Compose reads this file directly (env_file:), so the values above are what
# the containers get. Two are overridden per service and cannot be set here:
#
#   SERVICE_ROLE — set per service, as described at the top of this file.
#   REDIS_URL    — Compose forces redis://redis:6379/0, the Docker service
#                  name. A container's own localhost is not the host's.
#
# Host port for the API container. Change if 8000 is already taken.
API_PORT=8000

# ---------------------------------------------------------------------------
# Production note: none of this file goes to Railway
# ---------------------------------------------------------------------------
# Never upload .env to Railway and never bake it into an image. Railway uses
# environment-level Shared Variables, referenced per service:
#
#   DATABASE_URL=${{shared.NEON_DATABASE_URL_POOLED}}    API + worker only
#   DATABASE_URL_DIRECT=${{shared.NEON_DATABASE_URL_DIRECT}}   migrate only
#   REDIS_URL=${{Redis.REDIS_URL}}                       API + worker only
#
# The extractor service gets none of these. See
# docs/unified-railway-platform-plan.md and docs/railway-setup.md.
