# Dedicated Redis/PostgreSQL extraction dispatcher for Railway.
#
# Build:
#   docker build -f Dockerfile.worker -t graphify-run-worker .
#
# This is not the extraction sandbox. It consumes immutable run IDs, owns the
# singleton Railway service through PostgreSQL, and launches Dockerfile.sandbox
# deployments through Railway's API.
FROM python:3.12-slim AS builder

WORKDIR /build

# Explicit package inputs keep secrets, repository metadata, tests, and local
# artifacts out of every layer even if .dockerignore later regresses.
COPY pyproject.toml README.md LICENSE LICENSE-MIT NOTICE /build/
COPY graphify /build/graphify

# [server] includes SQLAlchemy/psycopg, FastAPI settings, HTTPX, cryptography,
# and the Redis asyncio client used by graphify-run-worker.
RUN pip wheel --no-cache-dir --wheel-dir /wheels ".[server]"

FROM python:3.12-slim AS runtime

WORKDIR /app
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels "graphifyy[server]" \
    && rm -rf /wheels

RUN useradd --create-home --uid 10001 graphify-worker
USER graphify-worker

ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["graphify-run-worker"]
