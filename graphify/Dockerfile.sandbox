# Extraction sandbox — the ephemeral container Railway runs per project.
#
# Distinct from ./Dockerfile, which builds the long-running MCP server. This
# one is a batch job: it clones a repo, extracts a graph, uploads the result,
# and exits.
#
# Build and push:
#   docker build -f Dockerfile.sandbox -t <registry>/graphify-sandbox:latest .
#   docker push <registry>/graphify-sandbox:latest
#
# Railway injects every input as an environment variable at deploy time (see
# graphify/server/sandbox.py) — nothing is baked into the image, so one image
# serves every project and no secret is ever committed to a layer.
FROM python:3.12-slim AS builder

WORKDIR /build
COPY pyproject.toml README.md LICENSE LICENSE-MIT NOTICE /build/
COPY graphify /build/graphify
RUN pip wheel --no-cache-dir --wheel-dir /wheels ".[openai,anthropic,gemini]"

FROM python:3.12-slim AS runtime

# git is the only system dependency: the tree-sitter grammars ship as wheels.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# [openai,anthropic,gemini] extras pull in the actual `openai`/
# `anthropic` SDKs that graphify's community-labeling step needs at runtime.
WORKDIR /app
COPY --from=builder /wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels \
        "graphifyy[openai,anthropic,gemini]" \
    && rm -rf /wheels

COPY scripts/sandbox_entrypoint.py /app/sandbox_entrypoint.py

# Non-root: this container executes code paths driven by an untrusted
# repository's contents, so it should not run as uid 0.
RUN useradd --create-home --uid 10001 sandbox \
    && mkdir -p /workspace \
    && chown -R sandbox:sandbox /workspace /app
USER sandbox

# Unbuffered so Railway's log stream shows progress live rather than in one
# burst at exit.
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "/app/sandbox_entrypoint.py"]
